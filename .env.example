# Amazon Bedrock configuration
AWS_REGION=us-east-1
SCAMSHIELD_BEDROCK_MODEL_ID=replace-with-a-model-id-available-in-your-account

# Optional: use an AWS named profile instead of environment access keys.
# AWS_PROFILE=your-profile

# Optional URL reputation provider. Safe Browsing v4 is documented for
# non-commercial use and is disabled when this value is empty.
# SCAMSHIELD_SAFE_BROWSING_API_KEY=replace-with-a-provider-key

# Optional deployed MCP endpoint. Leave unset for the local in-process
# official MCP client/server connection.
# SCAMSHIELD_MCP_URL=https://your-host.example/mcp

# Optional API configuration.
# SCAMSHIELD_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# SCAMSHIELD_API_KEY=replace-with-a-local-or-deployment-api-key
# SCAMSHIELD_SESSION_SIGNING_KEY=replace-with-a-long-random-secret
# SCAMSHIELD_FOLLOW_UP_TOKEN_TTL_SECONDS=900
# SCAMSHIELD_RATE_LIMIT_PER_MINUTE=30
